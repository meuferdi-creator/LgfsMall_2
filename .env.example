# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, CORS allow-list, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string (see schema.prisma - provider is postgresql).
DATABASE_URL="postgresql://user:password@localhost:5432/lgf_mall"

# JWT_SECRET: REQUIRED. Long random secret used to sign session tokens.
# The server refuses to start without this (see server.ts). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NEVER commit a real value here or in any file that gets checked into version control.
JWT_SECRET=""

# NODE_ENV: set to "production" in deployed environments (enables prod static serving,
# disables verbose dev-only console logs of verification/reset tokens).
NODE_ENV="development"

# Optional: override the auto-generated admin/vendor seed accounts and their
# passwords. If left unset, seedDatabase() generates strong random passwords
# and prints them ONCE to the server logs on first boot - capture and change
# them immediately. Never hardcode real credentials in source.
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""
ADMIN_SEED_PHONE=""
VENDOR_SEED_PASSWORD=""

# Firebase Client Configuration (Optional - used only for "Sign in with Google";
# falls back gracefully to local persistence if not set)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Supabase Configuration (used for Storage and OAuth 2.1 authentication).
# Put your own project's values here; never commit real keys to source control.
VITE_SUPABASE_URL="https://ybnaylyisexlcmlnkpyp.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_ML6RcCN5vspNrWcrEESBVg_M9oGxShl"
SUPABASE_URL="https://ybnaylyisexlcmlnkpyp.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_ML6RcCN5vspNrWcrEESBVg_M9oGxShl"
SUPABASE_SECRET_KEY=""
SUPABASE_JWKS_URL="https://ybnaylyisexlcmlnkpyp.supabase.co/auth/v1/.well-known/jwks.json"

# Supabase OAuth 2.1 Endpoints
SUPABASE_OAUTH_AUTHORIZE_URL="https://ybnaylyisexlcmlnkpyp.supabase.co/auth/v1/oauth/authorize"
SUPABASE_OAUTH_TOKEN_URL="https://ybnaylyisexlcmlnkpyp.supabase.co/auth/v1/oauth/token"
SUPABASE_OAUTH_JWKS_URL="https://ybnaylyisexlcmlnkpyp.supabase.co/auth/v1/.well-known/jwks.json"
SUPABASE_OAUTH_DISCOVERY_URL="https://ybnaylyisexlcmlnkpyp.supabase.co/auth/v1/.well-known/openid-configuration"
SUPABASE_OAUTH_CLIENT_ID=""
SUPABASE_OAUTH_CLIENT_SECRET=""

# Google Maps API Key (Optional, uses interactive maps with dynamic fallbacks if not set)
VITE_GOOGLE_MAPS_API_KEY=""

# Email Service Configuration (Nodemailer)
# In production, configure your production SMTP server:
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM='"LGF'\''s Mall" <no-reply@lgfmall.tg>'
SMTP_SECURE="false"

# In development / test / staging, emails are safely intercepted.
# Configure Mailtrap credentials (optional, auto-falls back to Ethereal Email sandbox):
MAILTRAP_HOST="sandbox.smtp.mailtrap.io"
MAILTRAP_PORT="2525"
MAILTRAP_USER=""
MAILTRAP_PASSWORD=""

