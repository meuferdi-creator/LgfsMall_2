```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.ts.map

# Environment variables
.env
.env.local
.env.*

# Logs
*.log

# IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Python artifacts (if any Python files exist in project)
__pycache__/
*.pyc
*.pyo
*.pyd

# Coverage reports
coverage/
htmlcov/
.coverage

# Local configuration
*.local
config/local.*
!config/*.json
!config/*.yml
!config/*.yaml

# OS generated files
.DS_Store
Thumbs.db
```